<% content_for :title, "Sobre mí · #{@profile.name}" %>

<section class="about-full">
  <div class="about-cinematic-card">
    <!-- Cabecera Inmersiva con Imagen Protagonista y Difuminado -->
    <div class="about-hero-banner">
      <% if @profile.photo.attached? %>
        <%= image_tag @profile.optimized_photo, alt: @profile.name, class: "banner-img" %>
      <% else %>
        <img src="https://images.unsplash.com/photo-1518546305927-5a4bbfe3a78a?w=1200&h=600&fit=crop&auto=format" alt="Foto de perfil" class="banner-img">
      <% end %>
      
      <!-- Capa de difuminado (Gradiente que desvanece la foto hacia la tarjeta) -->
      <div class="banner-fade-overlay"></div>

      <!-- Información superpuesta sobre la portada -->
      <div class="banner-content">
        <div class="about-identity">
          <h3><%= @profile.name %></h3>
          <% if @profile.role.present? %>
            <span class="role"><i class="fa-solid fa-terminal"></i> <%= @profile.role %></span>
          <% end %>
          <% if @profile.location_label.present? %>
            <span class="location"><i class="fa-solid fa-location-dot"></i> <%= @profile.location_label %></span>
          <% end %>
        </div>

        <% if logged_in? %>
          <div class="about-actions">
            <%= link_to "Editar perfil", edit_about_path, class: "btn-sm" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Cuerpo de la Biografía -->
    <div class="about-cinematic-body">
      <% if @profile.bio.present? %>
        <div class="bio-text markdown-body" style="white-space: pre-line;"><%= @profile.bio %></div>
      <% end %>

      <% if @profile.quote.present? %>
        <blockquote class="about-quote">
          <i class="fa-solid fa-quote-left" style="color:var(--accent); opacity:0.6;"></i>
          <span><%= @profile.quote %></span>
        </blockquote>
      <% end %>
    </div>
  </div>
</section>