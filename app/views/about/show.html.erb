<% content_for :title, "Sobre mí · #{@profile.name}" %>

<section class="about-full">
  <div class="about-card-vertical">
    
    <!-- Foto Protagonista Grande y Nítida -->
    <div class="about-hero-photo">
      <% if @profile.photo.attached? %>
        <%= image_tag @profile.optimized_photo, alt: @profile.name %>
      <% else %>
        <img src="https://images.unsplash.com/photo-1518546305927-5a4bbfe3a78a?w=800&h=1000&fit=crop&auto=format" alt="Foto de perfil">
      <% end %>
    </div>

    <!-- Identidad y Datos -->
    <div class="about-hero-info">
      <h3><%= @profile.name %></h3>
      <% if @profile.role.present? %>
        <span class="role"><i class="fa-solid fa-terminal"></i> <%= @profile.role %></span>
      <% end %>
      <% if @profile.location_label.present? %>
        <span class="location"><i class="fa-solid fa-location-dot"></i> <%= @profile.location_label %></span>
      <% end %>
    </div>

    <!-- Cuerpo de la Biografía -->
    <div class="about-hero-body">
      <% if @profile.bio.present? %>
        <div class="bio-text markdown-body">
          <%= markdown(@profile.bio) %>
        </div>
      <% end %>

      <% if @profile.quote.present? %>
        <blockquote class="about-quote">
          <i class="fa-solid fa-quote-left" style="color:var(--accent); opacity:0.6;"></i>
          <span><%= @profile.quote %></span>
        </blockquote>
      <% end %>
    </div>

    <% if logged_in? %>
      <div class="about-actions" style="margin-top: 1.5rem; text-align: center;">
        <%= link_to "Editar perfil", edit_about_path, class: "btn-sm" %>
      </div>
    <% end %>

  </div>
</section>