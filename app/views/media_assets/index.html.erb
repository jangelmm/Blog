<div class="media-manager-container">
  
  <header class="media-header">
    <h2>
      <i class="fa-regular fa-folder-open"></i>
      <code>/<%= @current_path %></code>
    </h2>
  </header>
  
  <div class="media-upload-zone">
    <%= form_with url: media_assets_path, local: true, multipart: true, class: "media-upload-form" do |form| %>
      <%= form.hidden_field :path, value: @current_path %>
      
      <div class="file-input-wrapper">
        <i class="fa-solid fa-cloud-arrow-up file-input-icon"></i>
        <%= form.file_field :files, multiple: true, name: "files[]", required: true, class: "custom-file-input" %>
      </div>
      
      <%= form.submit "Subir Archivo", class: "btn-primary" %>
    <% end %>
  </div>

  <div class="media-list">
    <% @assets.each do |asset| %>
      <% if asset.file.attached? %>
        <div class="media-list-row">
          
          <div class="media-list-thumb">
            <% if asset.file.image? %>
              <%= image_tag asset.file %>
            <% else %>
              <i class="fa-regular fa-file-lines doc-icon"></i>
            <% end %>
          </div>
          
          <div class="media-list-info">
            <span class="media-filename" title="<%= asset.file.filename %>">
              <i class="<%= asset.file.image? ? 'fa-regular fa-image' : 'fa-regular fa-file' %>"></i>
              <%= asset.file.filename %>
            </span>
            <span class="media-meta">
              <%= number_to_human_size(asset.file.byte_size) %> • <%= asset.created_at.strftime("%d %b %Y") %>
            </span>
          </div>
          
          <div class="media-list-snippet-container">
            <div class="media-snippet" onclick="copyToClipboard('![[<%= asset.file.filename %>]]', this)">
              <code>![[<%= truncate(asset.file.filename.to_s, length: 20) %>]]</code>
              <i class="fa-regular fa-copy copy-icon"></i>
            </div>
          </div>
          
          <div class="media-list-actions">
            <%= link_to rails_blob_path(asset.file, disposition: :attachment), download: asset.file.filename.to_s, title: "Descargar", class: "action-btn" do %>
              <i class="fa-solid fa-download"></i>
            <% end %>

            <%= button_to media_asset_path(asset), method: :delete, form: { data: { turbo_confirm: "¿Eliminar este archivo permanentemente?" } }, title: "Eliminar", class: "action-btn action-btn-danger" do %>
              <i class="fa-solid fa-trash-can"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if @assets.empty? %>
    <div class="empty-state media-empty">
      <i class="fa-regular fa-folder-open empty-icon"></i>
      <p>No hay archivos vinculados a esta ruta.</p>
    </div>
  <% end %>
</div>

<script>
  function copyToClipboard(text, element) {
    navigator.clipboard.writeText(text).then(() => {
      const icon = element.querySelector('.copy-icon');
      icon.classList.remove('fa-copy', 'fa-regular');
      icon.classList.add('fa-check', 'fa-solid');
      // Usamos la variable CSS del tema
      icon.style.color = 'var(--accent)';
      
      setTimeout(() => {
        icon.classList.remove('fa-check', 'fa-solid');
        icon.classList.add('fa-copy', 'fa-regular');
        icon.style.color = 'inherit';
      }, 2000);
    });
  }
</script> 