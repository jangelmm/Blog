<%= form_with model: project, url: (project.new_record? ? projects_path : project_path(project.slug)), local: true, multipart: true, class: "overleaf-ide-container" do |f| %>
  
  <% if project.errors.any? %>
    <div class="form-errors-banner">
      <p><strong><%= pluralize(project.errors.count, "error") %> impidieron guardar este proyecto:</strong></p>
      <ul><% project.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>

  <div class="ide-workspace">
    
    <aside class="overleaf-sidebar">
      <div class="sidebar-section-title">CONFIGURACIÓN DEL PROYECTO</div>
      
      <div class="sidebar-field">
        <%= f.label :title, "Título" %>
        <%= f.text_field :title, required: true, placeholder: "Ej. AstroReduce" %>
      </div>

      <div class="sidebar-field">
        <%= f.label :description, "Descripción Corta (Tarjeta)" %>
        <%= f.text_area :description, rows: 3, placeholder: "Extracto para el portafolio..." %>
      </div>

      <div class="sidebar-field">
        <%= f.label :tech_stack, "Tecnologías (separadas por coma)" %>
        <%= f.text_field :tech_stack, placeholder: "Python, C++, CUDA" %>
      </div>

      <div class="sidebar-field">
        <%= f.label :icon, "Ícono de respaldo (FontAwesome)" %>
        <%= f.text_field :icon, placeholder: "fa-solid fa-satellite" %>
      </div>

      <div class="sidebar-field">
        <%= f.label :position, "Orden (menor = primero)" %>
        <%= f.number_field :position, placeholder: "0" %>
      </div>

      <div class="sidebar-field">
        <%= f.label :image, "Imagen de Referencia" %>
        <%= f.file_field :image, accept: "image/*" %>
        <% if project.image.attached? %>
          <div class="sidebar-thumb-preview">
            <%= image_tag project.image %>
          </div>
        <% end %>
      </div>
    </aside>

    <main class="overleaf-editor-zone">
      <div class="editor-top-toolbar">
        <div class="toolbar-left" style="display: flex; gap: 0.5rem; align-items: center; height: 100%;">
          <span class="file-tab active">readme.md</span>
          <!-- Botón mágico para activar/desactivar la vista previa -->
          <button type="button" id="toggle-preview-btn-proj" class="btn-tiny" style="margin-left: 0.5rem; border:none; background: transparent;">
            <i class="fa-solid fa-columns"></i> Vista Previa
          </button>
        </div>
        <div class="toolbar-right">
          <span class="hint-text">Imágenes: ![[img.png]] o ![[/Proyectos/img.png]]</span>
        </div>
      </div>
      
      <div class="editor-split-view" id="split-view-proj">
        <!-- Lado Izquierdo: El Editor -->
        <div class="editor-textarea-wrapper">
          <%= f.text_area :body, id: "editor_textarea_proj", placeholder: "## Detalles técnicos\n\nEscribe la documentación de tu proyecto en Markdown aquí...", class: "ide-textarea" %>
        </div>
        
        <!-- Lado Derecho: La Vista Previa -->
        <div class="editor-preview-wrapper markdown-body" id="preview_pane_proj">
          <div class="preview-empty-state" style="color: var(--text-muted); text-align: center; margin-top: 4rem;">
            Escribe algo a la izquierda para ver la magia...
          </div>
        </div>
      </div>
    </main>
  </div>

  <footer class="overleaf-bottom-tray">
    <div class="tray-media-section">
      <div class="tray-media-header">
        <span class="tray-media-title">
          <i class="fa-regular fa-folder-open"></i> Repositorio de Medios
        </span>
        <%= link_to media_assets_path(path: "Proyectos"), target: "_blank", class: "btn-tiny" do %>
          <i class="fa-solid fa-arrow-up-right-from-square"></i> Abrir Carpeta
        <% end %>
      </div>
      <p class="tray-media-hint" style="margin-top: 0.3rem;">
        Sube diagramas en el gestor y usa <code>![[/Proyectos/nombre.png]]</code> en el editor.
      </p>
    </div>

    <div class="ide-actions-bar">
      <%= link_to "Cancelar", projects_path, class: "btn-ide-secondary" %>
      <%= f.submit (project.new_record? ? "Crear Proyecto" : "Guardar Cambios"), class: "btn-ide-primary" %>
    </div>
  </footer>
<% end %>

<script>
  document.addEventListener("turbo:load", () => {
    // Usamos IDs con "_proj" por si tienes ambos formularios en la misma sesión
    const textarea = document.getElementById("editor_textarea_proj");
    const previewPane = document.getElementById("preview_pane_proj");
    const toggleBtn = document.getElementById("toggle-preview-btn-proj");
    const splitView = document.getElementById("split-view-proj");

    if (!textarea || !previewPane) return;

    // 1. Lógica del Botón: Mostrar/Ocultar Vista Previa
    if (toggleBtn) {
      toggleBtn.addEventListener("click", () => {
        splitView.classList.toggle("show-preview");
        if (splitView.classList.contains("show-preview")) {
          toggleBtn.style.color = "var(--accent)";
          renderPreview(); // Renderizar inmediatamente al abrir
        } else {
          toggleBtn.style.color = "inherit";
        }
      });
    }

    // 2. Lógica del Editor: Auto-render con retraso (Debounce)
    let timeout = null;
    
    const renderPreview = () => {
      const metaCsrf = document.querySelector('meta[name="csrf-token"]');
      const csrfToken = metaCsrf ? metaCsrf.content : "";
      const textToRender = textarea.value;
      
      // La ruta para Proyectos es siempre "Proyectos"
      const currentPath = "Proyectos";

      fetch("/preview_markdown", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": csrfToken
        },
        body: JSON.stringify({ text: textToRender, path: currentPath })
      })
      .then(res => {
        if (!res.ok) throw new Error("Error de conexión con el servidor");
        return res.text();
      })
      .then(html => {
        previewPane.innerHTML = html;
        
        // Renderizar Ecuaciones Matemáticas (KaTeX)
        if (window.renderMathInElement) {
          window.renderMathInElement(previewPane, {
            delimiters: [
              {left: '$$', right: '$$', display: true},
              {left: '$', right: '$', display: false}
            ],
            throwOnError: false
          });
        }
        
        // Importación Dinámica de Mermaid JS
        const mermaidDivs = previewPane.querySelectorAll('.mermaid');
        if (mermaidDivs.length > 0) {
          import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs')
            .then(module => {
              module.default.initialize({ startOnLoad: false, theme: 'dark', fontFamily: 'Inter, sans-serif' });
              module.default.run({ nodes: mermaidDivs }).catch(err => console.warn("Mermaid error silencioso:", err));
            });
        }
      })
      .catch(err => console.error("Error al previsualizar:", err));
    };

    // 3. Escuchamos cuando escribes
    textarea.addEventListener("input", () => {
      // Solo gastamos recursos del servidor si el panel derecho está abierto
      if (!splitView.classList.contains("show-preview")) return;
      
      clearTimeout(timeout);
      timeout = setTimeout(renderPreview, 500); 
    });
  });
</script>